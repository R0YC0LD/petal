{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petal",
  "version": "0.9.11",
  "identifier": "com.by599.petal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "notch",
        "title": "Petal",
        "width": 190,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "dock",
        "title": "Petal",
        "width": 300,
        "height": 110,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipwho.is https://ipapi.co https://api.open-meteo.com https://geocoding-api.open-meteo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "R0YC0LD",
    "shortDescription": "Windows için notch ve dock",
    "longDescription": "Petal: Windows için akıcı, özelleştirilebilir notch ve dock. Geliştirici: R0YC0LD (Onur Teryakioğlu)",
    "copyright": "© R0YC0LD",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}